# OrcaRouter (OpenAI互換API) — サーバー側でのみ使用します。
# NEXT_PUBLIC_ を付けないでください（クライアントバンドルへ漏洩します）。
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.com/v1

# model="auto" でルーターにモデル選択を委ねます。
# 固定したい場合のみ指定してください。
ORCAROUTER_MODEL_CHEAP=auto
ORCAROUTER_MODEL_QUALITY=auto

# 1リクエストあたりのタイムアウト(ms)
ORCAROUTER_TIMEOUT_MS=20000

# 未設定の場合、アプリは決定論的フォールバック説明のみで動作します（全機能デモ可能）。

# 購入引き継ぎトークンの署名鍵（32文字以上）。
# 承認画面を経ずに外部サイトへ遷移させないための HMAC 署名に使います。
# 本番（NODE_ENV=production）では未設定だと起動時に失敗します。
# 開発時は起動ごとに変わる一時鍵が自動生成されます（承認済みリンクは再起動で失効）。
# 生成例: openssl rand -hex 32
CHIGIRI_HANDOFF_SECRET=
