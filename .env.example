# CHIGIRI Beauty の環境変数
#
# このファイルをコピーして .env.local を作り、値を入れてください。
#   cp .env.example .env.local
#
# .env.local は Git に入れないでください（.gitignore 済み）。
# Vercel では Project Settings > Environment Variables に同じ名前で入れます。
# ここに書かれた鍵は、すべてサーバー側でのみ読みます。
# NEXT_PUBLIC_ 接頭辞を付けないでください（付けるとブラウザへ露出します）。

# ------------------------------------------------------------------
# OrcaRouter（説明文の生成）
# ------------------------------------------------------------------
# 未設定でもアプリは動きます（決定論的な既定文にフォールバックします）。
ORCAROUTER_API_KEY=
# ORCAROUTER_BASE_URL=https://api.orcarouter.com/v1
# ORCAROUTER_MODEL_CHEAP=auto
# ORCAROUTER_MODEL_QUALITY=auto
# ORCAROUTER_TIMEOUT_MS=20000

# ------------------------------------------------------------------
# 引き継ぎトークンの署名鍵
# ------------------------------------------------------------------
# 未設定だと起動ごとに変わる一時鍵を使います（開発時のみ）。
# 本番では必ず設定してください。生成例:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CHIGIRI_HANDOFF_SECRET=

# ------------------------------------------------------------------
# 商品写真（楽天市場）
# ------------------------------------------------------------------
# https://webservice.rakuten.co.jp/ でアプリIDを取得します（無料・即時）。
# 未設定なら写真は引かず、線画のままになります。
RAKUTEN_APP_ID=
# アフィリエイトIDを入れると affiliateUrl が返ります。
# 提携リンクを表示する場合は、その旨の表記が必要です。
RAKUTEN_AFFILIATE_ID=

# ------------------------------------------------------------------
# 商品写真（Amazon Product Advertising API v5）
# ------------------------------------------------------------------
# Amazon アソシエイト・プログラムの承認済みアカウントが必要です。
# 一定期間内に適格販売がないと利用資格が失われる点に注意してください。
# 3つすべて揃っていないと照会しません。
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
# 既定は www.amazon.co.jp
# AMAZON_MARKETPLACE=www.amazon.co.jp

# 写真の保持時間(ms)。既定6時間、上限24時間（規約上これ以上は保持しません）
# MEDIA_CACHE_TTL_MS=21600000
# MEDIA_TIMEOUT_MS=8000

# ------------------------------------------------------------------
# AI利用費の上限
# ------------------------------------------------------------------
# 1日あたりのAI利用費の上限(円)。超えると外部呼び出しを止め、
# 決定論的な応答へ切り替えます（結果は表示され続けます）。
CHIGIRI_LLM_DAILY_BUDGET_JPY=300

# ------------------------------------------------------------------
# 外部AIへの送信可否（運用側スイッチ）
# ------------------------------------------------------------------
# 既定は on（OrcaRouter を推論基盤として使う前提のため）。
# ただし on でも、利用者が画面で「AIに文章を任せる」を選ぶまでは送信しません。
# 送信を完全に止めたい環境では off を指定してください。
CHIGIRI_EXTERNAL_AI=on

# ------------------------------------------------------------------
# 運用画面
# ------------------------------------------------------------------
# 1 のときだけ /ops を表示します。本番では設定しないでください。
CHIGIRI_OPS=
